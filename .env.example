# TypeSafe API key (required). Get one at https://console.typesafe.ai
TYPESAFE_API_KEY=

# TypeSafe model + endpoint (defaults are fine)
TYPESAFE_MODEL=jev-latest
TYPESAFE_URL=https://api.typesafe.ai/v1/systemone

# Device backend: sim (built-in simulator, default) or homeassistant.
GATEWAY=sim
# Home Assistant connection (only used when GATEWAY=homeassistant). Create a
# long-lived access token in HA: Profile -> Security -> Long-lived access tokens.
HASS_URL=http://localhost:8123
HASS_TOKEN=

# LLM pairing via a local Ollama server (compound-request splitting +
# conversational fallback). Requires `ollama serve` running with the model
# pulled (e.g. `ollama pull llama3.1:8b`). Set LLM_PROVIDER=none to use the
# built-in heuristics only.
LLM_PROVIDER=ollama
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# Sonos audio backend: mock (built-in Living Room/Kitchen/Deck zones, no
# hardware needed) or live (calls a running node-sonos-http-api).
SONOS_MODE=mock
SONOS_API_URL=http://localhost:5005

# Port the backend proxy listens on (Vite proxies /api here in dev)
PORT=8787
